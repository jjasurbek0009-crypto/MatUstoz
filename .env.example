# DIQQAT: bu faqat NAMUNA fayl. Haqiqiy kalitlarni .env fayliga yozing!
#   cp .env.example .env

# Telegram (@BotFather dan olinadi)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Anthropic API kaliti (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# PostgreSQL ulanish satri
DATABASE_URL=postgresql://postgres:parol@localhost:5432/matustoz

# Ixtiyoriy sozlamalar
MATUSTOZ_MODEL=claude-opus-5
MATUSTOZ_EFFORT=high
MATUSTOZ_MAX_TOKENS=16000
MATUSTOZ_HISTORY_LIMIT=40

# Docker uchun (docker-compose baza paroli)
POSTGRES_PASSWORD=kuchli-parol-yozing
