# Docker'siz variant: /etc/systemd/system/matustoz.service
[Unit]
Description=MatUstoz Telegram bot
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=matustoz
WorkingDirectory=/opt/matustoz
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
ExecStart=/opt/matustoz/.venv/bin/python -m bot.main
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
